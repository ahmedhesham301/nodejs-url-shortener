livedebugging {
	enabled = true
}

loki.write "loki" {
	endpoint {
		url = format("http://%s:%s/loki/api/v1/push", "{{ .Values.loki.host }}", "{{ .Values.loki.port }}")
	}
}

prometheus.remote_write "prometheus" {
	endpoint {
		url = format("http://%s:%s/prometheus/api/v1/write", "{{ .Values.prometheus.host }}", "{{ .Values.prometheus.port }}")
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "10.42.0.1:4317"

		tls {
			insecure             = true
			insecure_skip_verify = true
		}
	}
}
