livedebugging {
	enabled = true
}

loki.write "loki" {
	endpoint {
		url = string.format("http://%s:%s/loki/api/v1/push", sys.env("lokiHost"), sys.env("lokiPort"))
	}
}

prometheus.remote_write "prometheus" {
	endpoint {
		url = string.format("http://%s:%s/api/v1/write", sys.env("prometheusHost"), sys.env("prometheusPort"))
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = string.format("%s:%s", sys.env("tempoHost"), sys.env("tempoPort"))

		tls {
			insecure             = true
			insecure_skip_verify = true
		}
	}
}
