        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(tempo_distributor_push_duration_seconds_bucket{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        },
        {
          "refId": "B",
