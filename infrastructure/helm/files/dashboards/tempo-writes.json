            "uid": "${datasource}"
          },
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tempo_distributor_push_duration_seconds_bucket{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "p99",
