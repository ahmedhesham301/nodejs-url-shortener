              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(loki_ingester_memory_streams{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\"})",
          "legendFormat": "Streams",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(loki_ingester_memory_chunks{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\"})",
          "legendFormat": "Chunks",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Chunks flushed / sec",
      "type": "timeseries",
