{
  "uid": "reads",
  "title": "Loki / Reads",
  "description": "Single-binary Loki monitoring using directly scraped Prometheus metrics. CPU and memory cover the whole process. Read latency is absent when there are no queries.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "tags": [
    "loki",
    "single-binary"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Loki dashboards",
      "tags": [
        "loki"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "refresh": 1
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(loki_build_info, namespace)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(loki_build_info{namespace=~\"$namespace\"}, job)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(loki_build_info{namespace=~\"$namespace\",job=~\"$job\"}, pod)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "Read requests / sec",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Public query API requests. Zero means no matching requests while the scrape is healthy.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(loki_request_duration_seconds_count{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",route=~\"loki_api_v1_(query.*|label.*|series|index_.*)|api_prom_(query.*|label.*|series)\"}[$__rate_interval]))) or (sum(up{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\"} == 1) * 0)",
          "legendFormat": "Read requests / sec",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Read latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Latency needs queries in the selected rate window. Idle periods have no latency measurement.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No requests in range",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(loki_request_duration_seconds_bucket{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",route=~\"loki_api_v1_(query.*|label.*|series|index_.*)|api_prom_(query.*|label.*|series)\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(loki_request_duration_seconds_bucket{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",route=~\"loki_api_v1_(query.*|label.*|series|index_.*)|api_prom_(query.*|label.*|series)\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(loki_request_duration_seconds_bucket{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",route=~\"loki_api_v1_(query.*|label.*|series|index_.*)|api_prom_(query.*|label.*|series)\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Requests by route and status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route,status_code)(rate(loki_request_duration_seconds_count{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",route=~\"loki_api_v1_(query.*|label.*|series|index_.*)|api_prom_(query.*|label.*|series)\"}[$__rate_interval]))",
          "legendFormat": "{{route}} \u2014 {{status_code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Read failures / sec",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(loki_request_duration_seconds_count{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\",route=~\"loki_api_v1_(query.*|label.*|series|index_.*)|api_prom_(query.*|label.*|series)\",status_code=~\"5..|error\"}[$__rate_interval]))) or (sum(up{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\"} == 1) * 0)",
          "legendFormat": "Read failures / sec",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Queries in progress",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(loki_query_frontend_queries_in_progress{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\"})",
          "legendFormat": "Queries in progress",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Cache lookups / sec",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(loki_cache_hits{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "Hits",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(loki_cache_fetched_keys{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "Fetched keys",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "CPU used (cores)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "CPU for the entire single-binary process, including reads and writes.",
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod)(rate(process_cpu_seconds_total{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "CPU used (cores)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Process memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(process_resident_memory_bytes{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\"})",
          "legendFormat": "Resident memory",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(go_memstats_heap_inuse_bytes{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\"})",
          "legendFormat": "Go heap in use",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    }
  ],
  "annotations": {
    "list": []
  }
}
