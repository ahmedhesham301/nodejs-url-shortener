{
  "uid": "6c6b0f85-8b3a-47be-8341-4d455c8c6096",
  "title": "Tempo / Resources",
  "description": "Single-binary Tempo monitoring using directly scraped Prometheus metrics. CPU and memory cover the whole process. Read latency is absent when there are no queries.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "tags": [
    "tempo",
    "single-binary"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Tempo dashboards",
      "tags": [
        "tempo"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "refresh": 1
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(tempo_build_info, namespace)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(tempo_build_info{namespace=~\"$namespace\"}, job)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(tempo_build_info{namespace=~\"$namespace\",job=~\"$job\"}, pod)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "CPU used (cores)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "CPU for the entire single-binary process, including reads and writes.",
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod)(rate(process_cpu_seconds_total{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "CPU used (cores)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Process memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(process_resident_memory_bytes{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\"})",
          "legendFormat": "Resident memory",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(go_memstats_heap_inuse_bytes{namespace=~\"$namespace\",job=~\"$job\",pod=~\"$pod\"})",
          "legendFormat": "Go heap in use",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "range": true
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
